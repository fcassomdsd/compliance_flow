    {
        "id": "0ac20b5ee6e67291",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "inspector parameters",
        "func": "msg.entity = \"InspectedSpecialtyInspector\";\nmsg.entityData = { \"inspectedSpecialtyId\" : msg.specialties };\nmsg.entitySelect = \"inspectorName, inspectedSpecialtyName\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
