        "id": "185d79b48148ba56",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Set request parameters",
        "func": "msg.entity = \"ProtocolQuestion\";\nmsg.entityData = { \"id\" : msg.questionIds }\nmsg.entitySelect = \"code,topicName,sequence,texto,verification,references,normativas\";\n\nreturn msg;",
