    {
        "id": "b70f9835e7dad017",
        "type": "function",
        "z": "1151e4755687bce1",
        "name": "Set request parameters",
        "func": "msg.ids = msg.rmData.ids.reduce( (prev, curr) => prev + (curr ? \",\"+curr : \"\") );\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
