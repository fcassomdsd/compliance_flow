    {
        "id": "b56fec9bbbe16305",
        "type": "function",
        "z": "5afaefaae1db46d5",
        "name": "construct providers array",
        "func": "let providers = [];\nlet providerIds = [];\nlet thisOne = 0;\nfor (var provider of msg.payload.list) {\n  thisOne = providers.findIndex((x) => x.name == provider.serviceProviderName);\n  if (thisOne == -1) {\n    thisOne = providers.push({\n        \"id\" : provider.serviceProviderId,\n        \"name\" : provider.serviceProviderName,\n        \"contact\" : {},\n        \"services\" : []\n    });\n    thisOne--;\n    providerIds.push(provider.serviceProviderId);\n  }\n  \n  providers[thisOne].services.push({\n    \"name\" : provider.shortName,\n    \"specialties\" : msg.locationServiceObj[provider.id]\n  });\n}\n\nmsg.inspectionPlan[\"providers\"] = providers;\nmsg.providerIds = providerIds;\n\nmsg.payload = msg.inspectionPlan\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
