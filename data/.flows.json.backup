        "func": "msg.entity = \"InspectedSpecialtyInspector\";\nmsg.entityData = {\"inspectedSpecialtyId\" : msg.specialtyIds.map((x) => x.id)};\nmsg.entitySelect = \"inspectedSpecialtyId,inspectedSpecialtyName,inspectorName\";\nreturn msg;",
