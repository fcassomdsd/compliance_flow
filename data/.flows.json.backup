    {
        "id": "14c4bc83ec3010f5",
        "type": "function",
        "z": "5afaefaae1db46d5",
        "name": "extract schedules",
        "func": "function mapSchedule(schedule) {\n    switch (schedule.name) {\n        case \"+\": \n//          msg.inspectionPlan.openingDateTime = schedule.startDate;\n          return undefined;\n        case \"-\":\n//          msg.inspectionPlan.closureDateTime = schedule.startDate;\n          return undefined;\n        default:\n          return ({\n            \"name\" : schedule.name,\n            \"startDateTime\" : schedule.startDateTime,\n            \"endDateTime\" : schedule.endDateTime\n          })\n    }\n}\n\nmsg.inspectionPlan.openingDateTime = msg.payload.list.find((x) => x.name == \"+\").startDateTime;\nmsg.inspectionPlan.closureDateTime = msg.payload.list.find((x) => x.name == \"-\").startDateTime;\nmsg.inspectionPlan[\"schedules\"] = msg.payload.list\n                                    .map(mapSchedule)\n                                    .filter((x) => (x !== undefined));\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 660,
        "wires": [
