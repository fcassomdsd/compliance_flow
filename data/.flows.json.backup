        "id": "fffc0b7e8f13e374",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "get specialty info",
        "func": "var specialties = [];\nfor (var specialty of msg.payload.list) {\n  specialties.push(specialty.id);\n}\n\nmsg.specialties = specialties;\n\nreturn msg;",
        "outputs": 1,
