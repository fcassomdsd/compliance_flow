    {
        "id": "91bbed2b3cda5bd5",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "location services parameters",
        "func": "msg.entity = \"LocationService\";\nmsg.entityData = {\n    \"locationId\" : msg.locationId,\n    \"serviceProviderId\" : msg.providerId\n};\nmsg.entitySelect = \"inspectedServices\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
