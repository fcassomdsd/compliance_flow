    {
        "id": "5c497290c30a0c70",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "save inspection data",
        "func": "msg.inspectionReport = {\n    \"inspectionCode\" : msg.payload.list[0].code,\n    \"providerId\": msg.providerId,\n    \"reportDate\": msg.reportDate,\n    \"mainInspector\": msg.payload.list[0].mainInspectorName\n};\n\nmsg.inspectionId = msg.payload.list[0].id;\nmsg.locationId = msg.payload.list[0].locationId;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 280,
        "wires": [
            [
                "91bbed2b3cda5bd5"
            ]
        ]
    },
    {
        "id": "9b5aaa79e9d78dc4",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "construct services array",
        "func": "let serviceIds = [];\nfor (var locationService of msg.payload.list) {\n  for (var inspectedService of locationService.inspectedServices) {\n    if (inspectedService.inspectionId == msg.inspectionId ) {\n      serviceIds.push(inspectedService.id);\n    }\n  }\n}\n\nmsg.serviceIds = serviceIds;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 380,
        "wires": [
            [
                "eced5631dd2e7842"
            ]
        ]
    },
    {
        "id": "eced5631dd2e7842",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "inspected specialty parameters",
        "func": "msg.entity = \"InspectedSpecialty\";\nmsg.entityData = { \"inspectedServiceId\" : msg.serviceIds };\nmsg.entitySelect = \"id\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 210,
        "y": 520,
        "wires": [
