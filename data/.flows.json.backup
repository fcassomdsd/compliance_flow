        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "save inspection data",
        "func": "msg.inspectionId = msg.payload.list[0].id;\nmsg.checklist = {\n    \"inspection\": msg.payload.list[0].code,\n    \"inspectionId\" : msg.payload.list[0].id,\n    \"location\": msg.payload.list[0].locationName,\n    \"locationId\": msg.payload.list[0].locationId,\n    \"startDate\": msg.payload.list[0].startDate,\n    \"endDate\": msg.payload.list[0].endDate\n}\nreturn msg;",
