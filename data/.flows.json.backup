    {
        "id": "e81e909d1e22987d",
        "type": "function",
        "z": "5afaefaae1db46d5",
        "name": "construct specialties object",
        "func": "let serviceObj = {};\nlet serviceId = {};\nlet thisOne = 0;\nfor (var inspector of msg.payload.list) {\n    serviceId = msg.specialtyIds.find((x) => x.id == inspector.inspectedSpecialtyId);\n    if (!serviceObj[serviceId.serviceId]) {\n        serviceObj[serviceId.serviceId] = [];\n    }\n    thisOne = serviceObj[serviceId.serviceId].findIndex( (x) => x.name == inspector.inspectedSpecialtyName );\n    if (thisOne == -1) {\n        serviceObj[serviceId.serviceId].push({\n            \"name\" : inspector.inspectedSpecialtyName,\n            \"inspectors\" : [inspector.inspectorName]\n        })\n    } else {\n        serviceObj[serviceId.serviceId][thisOne].inspectors.push(\n            inspector.inspectorName\n        );\n    }\n}\n\nmsg.serviceObj = serviceObj;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 880,
        "wires": [
