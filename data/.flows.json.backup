        "type": "function",
        "z": "5afaefaae1db46d5",
        "name": "add contact info",
        "func": "let thisOne = 0;\nfor (var person of msg.payload.list) {\n    thisOne = msg.inspectionPlan.providers.findIndex( (x) => x.name == person.serviceProviderName);\n    msg.inspectionPlan.providers[thisOne].contact = {\n        \"name\" : person.name,\n        \"position\" : person.workPosition\n    }\n}\n\nmsg.payload = msg.inspectionPlan;\nreturn msg;",
