    {
        "id": "185d79b48148ba56",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Set request parameters",
        "func": "/*\nlet whereobj = {\n  \"type\":\"and\",\n  \"value\": []\n};\n\nif (msg.questionIds.length > 0) {\n  whereobj.value.push({\"type\": \"in\", \n                       \"attribute\": \"id\", \n                       \"value\": msg.questionIds});\n};\n\nmsg.payload = {\n    where : '[' + JSON.stringify(whereobj) + ']'\n};\n\nmsg.headers = { \"Authorization\": \"Bearer \" + msg.authToken };\n*/\n\nmsg.entity = \"ProtocolQuestion\";\nmsg.entityData = { \"id\" : msg.questionIds }\nmsg.entitySelect = \"topicName,sequence,texto,verification,normativas\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 700,
        "wires": [
            [
                "af6db56e177d734f"
            ]
        ]
    },
