    },
    {
        "id": "851e9b7e0566dddc",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Convert to checklist format",
        "func": "msg.payload = {   \"id\" : msg.payload.id,\n                  \"topic\" : msg.payload.topicName,\n                  \"sequence\" : msg.payload.sequence.toString().padStart(5,\"0\"),\n                  \"question\" : msg.payload.texto, \n                  \"verification\" : msg.payload.verification,\n                  \"reference\" : msg.payload.normativas.reduce((accu, actual) => { return accu + actual.reglamentoName + \" \" + actual.name + \"\\n\"}, \"\")\n                };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 1140,
        "wires": [
            [
                "1aa0da4621262a93"
            ]
        ]
    },
    {
        "id": "abb80c187da0adf6",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "add checklist header",
        "func": "let inspectionData = msg.payload.list[0];\nmsg.payload = {\"inspection\": inspectionData.code,\n               \"location\": inspectionData.locationName,\n               \"startDate\": inspectionData.startDate,\n               \"specialtyName\" : msg.specialty,\n               \"questions\" : msg.questions\n              }\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 860,
        "wires": [
            [
                "da1b9cfe4028bec1"
            ]
        ]
    },
