        "name": "save inspection data",
        "func": "msg.inspectionPlan = {\n    \"inspectionId\" : msg.payload.list[0].id,\n    \"inspectionNo\" : msg.payload.list[0].code,\n    \"localtionId\" : msg.payload.list[0].locationId,\n    \"locationName\": msg.payload.list[0].locationName,\n    \"objective\": msg.payload.list[0].objective,\n    \"scope\": msg.payload.list[0].scope,\n    \"mainInspector\": msg.payload.list[0].mainInspectorName,\n    \"secondaryInspector\": msg.payload.list[0].secondaryInspectorName,\n    \"startDate\": msg.payload.list[0].startDate\n};\n\nmsg.inspectionId = msg.payload.list[0].id\n\nreturn msg;",
