        "type": "split",
        "z": "f6f2187d.f17ca8",
        "name": "Split questions",
        "splt": "\\n",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "addname": "",
