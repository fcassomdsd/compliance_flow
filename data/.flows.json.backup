    {
        "id": "48f149e28a050195",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "save specialty data",
        "func": "msg.specialtyId = msg.payload.list[0].id;\nmsg.specialty = msg.payload.list[0].name;\nmsg.checklist[\"specialtyName\"] = msg.specialty;\nmsg.checklist[\"specialtyCode\"] = msg.payload.list[0].code;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
