    {
        "id": "ee96d9c8e4a422c0",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "set inspection params",
        "func": "msg.entity = \"Inspection\";\nmsg.entityData = { \"code\" : msg.inspectionCode };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
