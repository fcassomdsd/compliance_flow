    {
        "id": "603ea05e2b87ca0f",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "get inspector info",
        "func": "var inspectors = [];\nvar thisOne = -1;\nfor (var inspector of msg.payload.list) {\n  thisOne = inspectors.findIndex( (x) => x.name == inspector.inspectorName);\n  if (thisOne >= 0 ) {\n    inspectors[thisOne].specialty.push(\n      inspector.inspectedSpecialtyName\n    )\n  } else {\n    inspectors.push({\n      \"name\": inspector.inspectorName,\n      \"specialty\": [inspector.inspectedSpecialtyName]\n    })\n  }\n}\n\nmsg.inspectionReport[\"inspectors\"] = inspectors;\nmsg.payload = msg.inspectionReport;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
