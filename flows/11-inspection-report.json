        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "inspected specialty parameters",
        "func": "msg.entity = \"InspectedSpecialty\";\nmsg.entityData = { \"inspectedServiceId\" : msg.serviceIds.map((x) => x.id) };\nmsg.entitySelect = \"id, inspectedServiceId\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
