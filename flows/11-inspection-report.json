        "id": "5c497290c30a0c70",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "save site visit data",
        "func": "msg.inspectionReport = {\n    \"inspectionCode\" : msg.payload.list[0].code,\n    \"providerId\": msg.providerId,\n    \"reportDate\": msg.reportDate,\n    \"mainInspector\": msg.payload.list[0].mainInspectorName,\n    \"locale\": msg.locale || \"es\"\n};\n\nmsg.locationId = msg.payload.list[0].locationId;\nmsg.siteVisitId = msg.payload.list[0].id;\n\nreturn msg;",
