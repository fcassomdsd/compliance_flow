    {
        "id": "9b5aaa79e9d78dc4",
        "type": "function",
        "z": "041ce3d9cda14530",
        "name": "construct services array",
        "func": "let serviceIds = [];\nlet thisOne = -1;\nfor (var locationService of msg.payload.list) {\n  for (var inspectedService of locationService.inspectedServices) {\n    if (inspectedService.inspectionId == msg.inspectionId ) {\n      serviceIds.push({\n        \"id\" : inspectedService.id,\n        \"name\" : inspectedService.name\n      })\n    }\n  }\n}\n\nmsg.serviceIds = serviceIds;\nmsg.inspectionReport[\"services\"] = serviceIds;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 420,
        "wires": [
