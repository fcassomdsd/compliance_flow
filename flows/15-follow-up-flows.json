    {
        "id": "463ace0ebbc03553",
        "type": "function",
        "z": "5e1aad1777646734",
        "name": "format findings",
        "func": "// look for follow ups for this finding\nconst rgx = \"^\" + msg.prefix;\nconst followUpList = msg.payload.list.entries.map( (x) => \n    x.entry.name\n  ).filter((x) => x.match(rgx)\n  )\nif (followUpList.length == 0) {\n    msg.payload = \"00\";\n} else {\n  const lastOneParts = followUpList.sort()[followUpList.length-1].split(\" \");\n  msg.payload = lastOneParts[lastOneParts.length-1];\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 340,
        "wires": [
