    {
        "id": "7251cf3fe6b2a510",
        "type": "function",
        "z": "4462ef5386374bff",
        "name": "Create inspection object",
        "func": "var list = (msg.payload && msg.payload.list) || [];\nif (list.length === 0) {\n    // A lookup by id with no match is a 404, not a 200 full of nulls.\n    msg.statusCode = 404;\n    if (msg.res) { msg.res.statusCode = 404; }\n    var wanted = (msg.req && msg.req.params && msg.req.params.externalId) || \"\";\n    msg.payload = { success: false, error: \"Inspector not found: \" + wanted };\n    return msg;\n}\nmsg.inspector = {\n    \"id\" : list[0]?.id,\n    \"name\" : list[0]?.name,\n    \"serviceAreaId\" : list[0]?.serviceAreaId || null,\n    \"serviceAreaName\" : list[0]?.serviceAreaName || null,\n    \"specialties\" : list[0]?.specialty?.map((x) =>\n        ({\n            \"id\": x.id,\n            \"code\" : x.code,\n            \"name\" : x.name\n        }))\n}\nmsg.payload = msg.inspector;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
