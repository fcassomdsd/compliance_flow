    {
        "id": "f274d07e82b8dbc1",
        "type": "function",
        "z": "4462ef5386374bff",
        "name": "create inspection object",
        "func": "const list = (msg.payload && msg.payload.list) || [];\nconst inspection = list[0];\n\n// A miss used to leave msg.payload undefined and the response node answered 200\n// with an empty body - invisible to the smoke harness, whose JSON assertions all\n// require a non-empty response. Answer it here rather than via node.error: this\n// tab has two catch nodes, and routing an error through them produced duplicate\n// responses that wedged the flow for subsequent requests.\nif (!inspection) {\n    msg.statusCode = 404;\n    msg.payload = { success: false, error: \"Inspection not found: \" + msg.req.params.inspectionId };\n    return msg;\n}\n\nmsg.payload = inspection;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
