    {
        "id": "b119067bf8ac10b3",
        "type": "function",
        "z": "4462ef5386374bff",
        "name": "set inspector params",
        "func": "// The route is /inspection/:inspectionId and the README documents it as an\n// INSPECTION lookup, but it used to query SiteVisit (keying on `code` for the\n// legacy \"MD...\" site-visit codes). It now queries Inspection, matching the\n// documented contract and the per-provider status model. Inspection codes use\n// the Nomenclatura \"AV-...\" form, so the key follows from that prefix.\nconst inspectionId = msg.req.params.inspectionId;\nmsg.entity = \"Inspection\";\nmsg.entityData = (inspectionId.substring(0, 3) == \"AV-\")\n      ? ({ \"code\" : inspectionId })\n      : ({ \"id\" : inspectionId });\nmsg.entitySelect = \"id,code,status,objective,scope,locationId,locationName,inspectedProviderId,inspectedProviderName,activityTypeId,activityTypeName\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
