        "func": "msg.checklist[\"severityConfig\"] = [\n    { \"id\": \"A\", \"name\": \"A\", \"daysToSolution\": 7 },\n    { \"id\": \"B\", \"name\": \"B\", \"daysToSolution\": 30 },\n    { \"id\": \"C\", \"name\": \"C\", \"daysToSolution\": 90 }\n];\nmsg.checklist[\"questions\"] = msg.questions;\nmsg.payload = msg.checklist;\nreturn msg;",
