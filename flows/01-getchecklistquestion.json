    {
        "id": "9f2a17c3b6e4d801",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "collect acapitesOACI ids",
        "func": "msg.pqList = msg.payload.list || [];\nconst ids = [...new Set(msg.pqList\n  .map(q => q.normativas && q.normativas[0] && q.normativas[0].acapitesOACIId)\n  .filter(Boolean))];\nmsg.acapiteIds = ids;\n\nif (ids.length === 0) {\n    msg.payload = { list: [] };\n    return [null, msg];\n}\n\n// Query from the AcapiteOACI side and embed usoapProtocolQuestions -\n// AtroCore's linkMultiple where-filter does not support filtering directly\n// by a many-to-many attribute (e.g. acapitesOACI IN [...] on\n// UsoapProtocolQuestion), but a single-level embedded select from the\n// owning side (AcapiteOACI.usoapProtocolQuestions) works, same as the\n// existing normativas embedding above.\nmsg.entity = \"AcapiteOACI\";\nmsg.entityData = { \"id\": ids };\nmsg.entitySelect = \"usoapProtocolQuestions\";\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 1000,
        "wires": [
            [
                "36b5ca3c0f2b751b"
            ],
            [
                "9f2a17c3b6e4d803"
            ]
        ]
    },
    {
        "id": "9f2a17c3b6e4d803",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "merge usoap pq into questions",
        "func": "const acapiteList = (msg.payload && msg.payload.list) || [];\nconst byAcapite = {};\nfor (const acapite of acapiteList) {\n  const pqs = acapite.usoapProtocolQuestions || [];\n  byAcapite[acapite.id] = pqs.map((pq) => ({\n    code: pq.code,\n    criticalElement: pq.criticalElementName,\n    areaCode: pq.areaCodeName\n  }));\n}\n\nfor (const q of (msg.pqList || [])) {\n  const n = q.normativas && q.normativas[0];\n  if (n) {\n    n.usoapPqReference = byAcapite[n.acapitesOACIId] || [];\n  }\n}\n\nmsg.payload = { list: msg.pqList, total: msg.pqList.length };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 870,
        "y": 1040,
        "wires": [
            [
                "5552e88df9693eeb"
            ]
        ]
    },
