        "func": "var list = (msg.payload && msg.payload.list) ? msg.payload.list : [];\nmsg.payload = list.filter(function(x) {\n  var s = x.status || \"\";\n  return s === \"Planned\" || s === \"Uploaded\" || s === \"Reported\" || s === \"Complete\";\n}).map(function(x) {\n  return { \"id\": x.id, \"code\": x.code, \"locationName\": x.locationName, \"status\": x.status };\n});\nreturn msg;",
