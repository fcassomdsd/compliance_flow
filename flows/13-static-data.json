    {
        "id": "a488c6d53f464a9c",
        "type": "function",
        "z": "dbdd767669d57957",
        "name": "map inspectors by specialty",
        "func": "const code = String(msg.specialtyCode || \"\").toUpperCase();\nconst rows = (msg.payload && Array.isArray(msg.payload.list)) ? msg.payload.list : [];\n\n// AtroCore cannot filter a many-to-many link in a where clause, so the\n// Specialty relation (Inspector.specialty, the same link /inspector/:id uses)\n// is matched here on the rows the query returned.\nmsg.payload = rows\n  .filter((row) => Array.isArray(row.specialty) &&\n    row.specialty.some((entry) => String((entry && entry.code) || \"\").toUpperCase() === code))\n  .map((row) => ({\n    id: row.id,\n    name: row.name,\n    externalUserID: row.externalUserID || null\n  }));\n\nreturn msg;",
