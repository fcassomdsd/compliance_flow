        "func": "const query = (msg.req && msg.req.query) || {};\nconst raw = query.specialty || query.specialtyCode || \"\";\nconst code = String(raw).trim().toUpperCase();\n\nif (!code) {\n  msg.statusCode = 400;\n  if (msg.res) { msg.res.statusCode = 400; }\n  msg.payload = { success: false, error: \"specialty query parameter is required\" };\n  return [null, msg];\n}\n\nmsg.specialtyCode = code;\nmsg.entity = \"Inspector\";\nmsg.entityData = { deleted: false };\nmsg.entitySelect = \"id,name,externalUserID,specialty\";\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
