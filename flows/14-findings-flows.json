        "name": "prepare payload",
        "func": "msg.scriptPayload = {};\nif (msg.locationId) {\n  msg.scriptPayload[\"locationId\"] = msg.locationId\n} else {\n  if (msg.locationCode) {\n    msg.scriptPayload[\"locationCode\"] = msg.locationCode\n  }\n}\n\nif (msg.specialtyId) {\n  msg.scriptPayload[\"specialtyId\"] = msg.specialtyId\n} else {\n  if (msg.specialtyCode) {\n    msg.scriptPayload[\"specialtyCode\"] = msg.specialtyCode\n  }\n}\n\nreturn msg;",
