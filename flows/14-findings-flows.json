        "id": "4afccf560762d782",
        "type": "function",
        "z": "be74fd69d845153f",
        "name": "format findings",
        "func": "const findingList = msg.payload.findings.map( (x) => {\n    const f = x.finding;\n    if (f.correctiveAction.capId == \"\") {\n       f.correctiveAction = undefined;\n    }\n    return f;\n    });\nmsg.payload = findingList;\nreturn msg;",
