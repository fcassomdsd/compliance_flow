        "func": "var list = msg.payload && msg.payload.list;\nif (!list || list.length === 0) {\n    node.warn(\"Site visit not found in AtroCore for status update\");\n    return;\n}\n\nvar siteVisit = list[0];\nvar currentStatus = siteVisit.status;\nvar siteVisitId = msg.siteVisitId;\n\n/*if (currentStatus !== \"Planned\") {\n    node.warn(\"Site visit status is \" + currentStatus + \", not transitioning to Uploaded\");\n    return;\n}\n*/\nmsg.entityId = siteVisitId;\nmsg.updateData = { status: \"Uploaded\" };\nreturn msg;",
