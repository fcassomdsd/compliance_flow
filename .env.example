# Node-RED Compliance Inspection API
# Copy this file to .env before running docker compose, then replace every value.
# docker compose refuses to start when a required variable is unset, and Node-RED
# refuses to start with NODE_ENV=production unless the required values are present.

# Alfresco credentials (used when the caller does not forward a user ticket)
ALFRESCO_USERNAME=replace-me
ALFRESCO_PASSWORD=replace-me

# AtroCore credentials
ATROCORE_USERNAME=replace-me
ATROCORE_PASSWORD=replace-me

# API key required on every REST endpoint through the X-API-Key header.
# Leave empty for local development only; production startup fails when unset.
API_KEY=

# Node-RED editor login (bcrypt hash)
# Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 8))" 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Encryption secret for stored flow credentials. Generate a long random value.
# Changing this after credentials are stored makes them unreadable.
NODE_RED_CREDENTIAL_SECRET=replace-me

# Set to "production" to enable the startup validation described above.
NODE_ENV=development

# Upstream endpoints. Defaults match the compose stack's service names.
ATROCORE_BASE_URL=http://atro-web/api/v1
ALFRESCO_BASE_URL=http://proxy:8080/alfresco

# Per-request timeout in milliseconds. Leave empty to keep the http request
# node's own default (5000).
HTTP_REQUEST_TIMEOUT_MS=

# Retry policy for the auth/query/CRUD subflows' upstream calls: how many extra
# attempts after the first, and the base backoff in milliseconds (attempt N waits
# N * backoff).
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_MS=500
