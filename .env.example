# Node-RED Compliance Inspection API
# Copy this file to .env before running docker compose.
# Defaults are DEVELOPMENT ONLY — change for any non-local deployment.

# Alfresco credentials (used when frontend does not forward a user ticket)
ALFRESCO_USERNAME=admin
ALFRESCO_PASSWORD=admin

# API key for REST endpoint protection (leave empty for dev mode — no auth)
# Set to a shared secret to require X-API-Key header on all endpoints.
API_KEY=

# Node Editor admin login (bcrypt hash)
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('password', 8))"
# Default hash below corresponds to password "password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$08$zZWtXTja0fB1pzD4sHCMyOCMYz2Z6dNbM6tl8sJogENOMcxWV9DN.

# Encryption secret for flow credentials (change in production)
NODE_RED_CREDENTIAL_SECRET=a-secret-key
